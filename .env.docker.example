# Copy values into a local `.env` when running in Docker, or rely on compose `environment:`.
# Do not commit real secrets.

APP_NAME="Enterprise WMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://127.0.0.1:8100
APP_PORT=8100
PORT=8100

DB_CONNECTION=mysql
DB_HOST=live-mysql
DB_PORT=3306
DB_DATABASE=warehouse
DB_USERNAME=laravel
DB_PASSWORD=secret

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
REDIS_HOST=live-redis
REDIS_PORT=6379

LOG_CHANNEL=stderr
